<Window x:Class="PR7._2_efanova_lopatina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROT13 — вариант 12"
        Height="560"
        Width="720"
        MinHeight="500"
        MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Открытый текст (шифрование):"
                   FontSize="15"
                   FontWeight="Bold"/>

        <TextBox x:Name="PlainTextBox"
                 Grid.Row="1"
                 Margin="0,6,0,0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="100000"
                 ToolTip="Латинские буквы A–Z и a–z сдвигаются на 13; остальные символы не изменяются."/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
            <Button Content="Зашифровать"
                    Width="150"
                    Margin="8"
                    Click="Encrypt_Click"
                    ToolTip="Модуль Rot13Encryptor: ROT13 для открытого текста."/>
            <Button Content="Дешифровать"
                    Width="150"
                    Margin="8"
                    Click="Decrypt_Click"
                    ToolTip="Модуль Rot13Decryptor: ROT13 для шифротекста."/>
            <Button Content="Очистить всё"
                    Width="150"
                    Margin="8"
                    Click="Clear_Click"
                    ToolTip="Очистить все поля."/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,6"
                   Text="Шифротекст (ввод для дешифрования):"
                   FontSize="15"
                   FontWeight="Bold"/>

        <TextBox x:Name="CipherInputTextBox"
                 Grid.Row="4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="100000"
                 ToolTip="Введите шифротекст или используйте результат шифрования."/>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,6"
                   Text="Результат операции:"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="ResultTextBox"
                 Grid.Row="6"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Результат последней операции (только чтение)."/>

        <TextBlock Grid.Row="7"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="12"
                   Text="Вариант 12: ROT13. Документация — папка Documents рядом с .exe."/>
    </Grid>
</Window>